NODE_ENV=development
PORT=5000
MONGO_URI=
CLIENT_URL=http://localhost:5173

# AWS Cognito (login) aur Rekognition (privacy scan + waste labels)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# rekognition = asli scan. local = sirf dev (plates / unsafe / waste labels nahi chalte)
PRIVACY_SCAN=rekognition

# Cloudinary (private originals + public blurred copies)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (BullMQ queue + site-merge lock)
REDIS_URL=

# Reverse geocode
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=JunkSnap/1.0 (your-email@example.com)

# Groq vision judge (Day 11). Key na ho ya VERIFY_LLM=off ho to sirf Rekognition labels se decide hota hai
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VERIFY_LLM=on
